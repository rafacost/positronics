// Positronics starter kit: "NCP Emergency Reclamation Kit". Hardcore: only what the island can't give you.
// - The cobblestone generator needs an iron block to craft, and there is no iron yet.
// - Gravel and sand come from hand-hammering cobblestone (Reclamation Hammer), not from more generators.
// - Water: the island spring + the kiosk campfire (boil bottles). Purified water is learned, not given.
// Format: https://wiki.chaotictrials.de/docs/1.20.x/wiki/skyblock-builder/packdev/config/inventory#starting-inventory
{
  "items": [
    { "item": "usrg:cobblegenerator", "count": 1 },

    // TEMPORARY: USRG generators can't be emptied by hand yet. Remove once USRG supports
    // right-click output (prompt: docs/prompts/usrg-right-click-output.md).
    { "item": "minecraft:hopper", "count": 1 },

    { "item": "minecraft:glass_bottle", "count": 2 },
    { "item": "botanypots:terracotta_botany_pot", "count": 1 },
    { "item": "pamhc2crops:tomatoseeditem", "count": 2 },
    { "item": "minecraft:oak_sapling", "count": 1 },
    { "item": "minecraft:bread", "count": 3 }
  ]
}
