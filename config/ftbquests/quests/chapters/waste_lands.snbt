	quests: [
		{
			description: [
				"&7[NCP Field Memo #0001: Orientation]"
				""
				"Good morning, Reclamation Operator."
				"The world has moved on, and most of it moved away. What's left is this rock, one ruined NCP kiosk, and you."
				""
				"Your assignment: rebuild the North Central Positronics network, one tier at a time."
				"Nothing here has ore. Nothing here spawns. Nobody is coming."
				"Everything you will ever own, you will &areclaim&r, &aprocess&r or &aremember&r."
				""
				"&eOpen this book any time with the quest key. Claim rewards with the button on each quest.&r"
				""
				"&7Enclosed: a thermometer and a season calendar. The weather out here will try to kill you. Know it first."
			]
			icon: "minecraft:lantern"
			id: "504F530000001001"
			rewards: [
				{
					count: 3
					id: "504F530000003001"
					item: "positronics:ncp_scrip"
					type: "item"
				}
				{
