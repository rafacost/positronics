				"504F530000001008"
			]
			description: [
				"&7[NCP Field Memo #0009: Glassworks]"
				""
				"Cobblestone makes a furnace. Plain sand won't melt into clear glass here; hammer it down to &bdust&r first."
				"Smelt the dust and you get glass. Glass makes bottles, and bottles carry water. Everything connects."
				"&7No coal for a new campfire? Logs and sticks make a rough one."
			]
			id: "504F530000001009"
			rewards: [{
				id: "504F53000000300E"
				item: "positronics:ncp_scrip"
				type: "item"
