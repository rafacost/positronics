			}]
			title: "Pot Luck"
			x: 3.0d
			y: 3.5d
		}
		{
			dependencies: ["504F530000001006"]
			description: [
				"&7[NCP Field Memo #0007: Nutrition]"
				""
				"The same meal every day keeps you alive. &bMany different foods&r make you stronger:"
				"every few new foods you try grant you an extra heart, for good."
				""
				"&aNo kitchen needed:&r a &bGarden Salad&r (bowl, tomato, lettuce) and a &bVegetable Broth&r"
				"(bowl, tomato, onion, a bottle of purified water) are crafted by hand. Bread, tomato and lettuce make a &bGarden Sandwich&r."
				"&7It isn't much. Out here, it's a feast."
			]
			id: "504F530000001007"
			rewards: [{
				count: 2
				id: "504F53000000300C"
				item: "positronics:ncp_scrip"
				type: "item"
			}]
			subtitle: "Variety is the spice of life"
			tasks: [
				{
