					item: "positronics:vegetable_broth"
					type: "item"
				}
			]
			title: "Variety Is the Spice"
			x: 10.0d
			y: 3.5d
		}
		{
			dependencies: ["504F530000001001"]
			description: [
				"&7[NCP Field Memo #0008: Timber]"
				""
				"That dead tree on the island still has two good logs in it. Your kit has one sapling. Don't waste it."
				""
				"&aPlant, grow, cut, replant.&r Wood is your first fuel, your first tools and your first workbench."
				"&7Somebody planted that dead tree once, too. Do better than they did."
			]
			id: "504F530000001008"
			rewards: [{
				count: 2
				id: "504F53000000300D"
				item: "positronics:ncp_scrip"
				type: "item"
