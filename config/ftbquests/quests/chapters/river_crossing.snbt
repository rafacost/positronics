					timer: 0L
					to_observe: "botanypots:terracotta_hopper_botany_pot"
					type: "observation"
				}
				{
					count: 128L
					id: "305E27A2048E248A"
					item: "chemlib:hydrogen"
					type: "item"
				}
			]
			title: "Hands Off"
			x: 12.5d
			y: 4.0d
		}
		{
			dependencies: ["0788A02A25C2D582" "5BF37B5D49C970E6"]
			description: [
				"&7[NCP Field Memo #0119: Capacitors]"
				""
				"NCP calls it a Beam Capacitor. The people who built it called it an Antimatter Relay, and I'd believe either one."
				"It takes anything with EMC, burns it, and pours what's left into a &bKlein Star&r."
				"&aClose the loop:&r point the Reclaimer's output hopper at the Capacitor instead of the chest, with a star inside."
				"The plants grow, the atoms fall, the star fills up, and nobody has to be at the bench."
				"Four stars combine into the next size up, and the charge comes along."
			]
			id: "3F19BE1DC07334EB"
			rewards: [
				{
					count: 2
					id: "2DBF4D2012100BC8"
					item: "positronics:ncp_scrip"
