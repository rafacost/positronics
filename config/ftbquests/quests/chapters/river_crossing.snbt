			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["69ADFFCDC361D941"]
			description: [
				"&7[NCP Field Memo #0103: Metalwork]"
				""
				"Put an iron ingot back in the fire. It comes out darker, tougher, a little meaner: &bwrought iron&r."
				"Everything at ULV is made of it. Make eight. You'll want eighty."
			]
			id: "0E9A732B4BBA6767"
