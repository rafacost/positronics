		{
			dependencies: ["70EDF0098A06DF89"]
			description: [
				"&7[NCP Field Memo #0109: Circuitry]"
				""
				"The old people built these before everything stopped."
				"They glow a little when they work, like they're remembering something."
				"The ULV circuit: glass, wire and patience. Mostly patience."
			]
			id: "5BF37B5D49C970E6"
